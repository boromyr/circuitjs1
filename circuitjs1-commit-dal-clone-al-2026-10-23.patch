diff --git a/src/com/lushprojects/circuitjs1/client/ScopeControls.java b/src/com/lushprojects/circuitjs1/client/ScopeControls.java
new file mode 100644
index 00000000..6ad88269
--- /dev/null
+++ b/src/com/lushprojects/circuitjs1/client/ScopeControls.java
@@ -0,0 +1,407 @@
+/*
+    Copyright (C) Paul Falstad and Iain Sharp
+
