-	stor.setItem("lastSession", sessionJSON(dumpCircuit(), file, ui.circuitTitle, unsavedChanges));
+	try {
+	    stor.setItem("lastSession", sessionJSON(dumpCircuit(), file, ui.circuitTitle, unsavedChanges));
