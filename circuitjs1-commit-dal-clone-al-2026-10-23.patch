From 11ff6ddbc14ad0abd7f05980862eb45256ef17dd Mon Sep 17 00:00:00 2001
From: boromyr <52782032+boromyr@users.noreply.github.com>
Date: Tue, 20 Oct 2026 18:15:16 +0000
Subject: [PATCH] Aggiungi i controlli rapidi dell'oscilloscopio nel pannello
 laterale
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Slider per scala orizzontale e verticale dell'oscilloscopio selezionato
  (ultimo cliccato), con scelta del canale e casella Auto
- In scala manuale: trigger con modalità, fronte e slider del livello
- Evidenziazione e indicatore dell'oscilloscopio controllato
- Iframe del pannello laterale in display:block (niente overflow in basso)

diff --git a/src/com/lushprojects/circuitjs1/client/MouseManager.java b/src/com/lushprojects/circuitjs1/client/MouseManager.java
index 01de6c26..89ed1871 100644
--- a/src/com/lushprojects/circuitjs1/client/MouseManager.java
+++ b/src/com/lushprojects/circuitjs1/client/MouseManager.java
@@ -927,6 +927,7 @@ public class MouseManager implements MouseDownHandler, MouseMoveHandler, MouseUp
 	if (ui.isReadOnly() || sim.dialogIsShowing())
 	    return;
     	menuElm = mouseElm;
+    	sim.scopeManager.setActiveScopeFromMouse(mouseElm);
     	sim.scopeManager.menuScope=-1;
     	sim.scopeManager.menuPlot=-1;
     	if (sim.scopeManager.scopeSelected!=-1) {
@@ -1077,6 +1078,7 @@ public class MouseManager implements MouseDownHandler, MouseMoveHandler, MouseUp
 
     	// set mouseElm in case we are on mobile
     	mouseSelect(e);
+    	sim.scopeManager.setActiveScopeFromMouse(mouseElm);
 
     	mouseDragging=true;
     	didSwitch = false;
