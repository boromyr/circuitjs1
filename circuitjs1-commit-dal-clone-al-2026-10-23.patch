-		    restoreLastSession();
+		    try {
+			restoreLastSession();
+		    } catch (Exception e) {
+			// a session that can't be loaded must not stop every start: forget it
+			console("can't restore last session: " + e);
+			Storage.getLocalStorageIfSupported().removeItem("lastSession");
+			readCircuit("");
+			menus.getSetupList(true);
