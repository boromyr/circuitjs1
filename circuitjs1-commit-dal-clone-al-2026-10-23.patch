+	    return activeScope;
+	activeScope = null;
+	if (scopeCount > 0)
+	    activeScope = scopes[0];
+	else if (sim.scopeElmArr != null && sim.scopeElmArr.length > 0)
+	    activeScope = sim.scopeElmArr[0].elmScope;
+	return activeScope;
+    }
+
+    void setActiveScope(Scope s) {
