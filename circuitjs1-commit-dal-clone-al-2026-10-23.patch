From 7de0e8e690ae2ef186b2d06f9a3cceac1875d41e Mon Sep 17 00:00:00 2001
From: boromyr <52782032+boromyr@users.noreply.github.com>
Date: Tue, 20 Oct 2026 01:18:23 +0200
Subject: [PATCH] Aggiungi la gestione dei file recenti nell'applicazione
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Aggiungi la gestione dei file recenti nell'applicazione, migliorando l'usabilità e la funzionalità.
- Implementa funzioni di supporto per il caricamento, la salvaguardia e la visualizzazione dei file recenti nei menu.
- Fornisci la localizzazione adeguata per le interazioni legate ai file recenti in lingua italiana.

diff --git a/app/main.js b/app/main.js
index 5400fdcd..6e0c55c8 100644
--- a/app/main.js
+++ b/app/main.js
@@ -233,6 +233,50 @@ ipcMain.on('new-window', () => {
   createWindow();
 });
 
+// The last files opened, most recent first (File > Open Recent), kept in the
+// profile and shared by all the windows.
+var MAX_RECENT = 10;
+
+function recentFilesFile() {
+  return path.join(app.getPath('userData'), 'recent-files.json');
+}
+
+function loadRecentFiles() {
+  try {
+    var list = JSON.parse(fs.readFileSync(recentFilesFile(), 'utf8'));
+    if (Array.isArray(list))
+      return list.filter(function (f) { return typeof f === 'string'; }).slice(0, MAX_RECENT);
+  } catch (e) {}
+  return [];
+}
+
+function saveRecentFiles(list) {
+  try {
+    fs.writeFileSync(recentFilesFile(), JSON.stringify(list, null, 1));
+  } catch (e) {}
+}
+
+function sameFile(a, b) {
+  return process.platform === 'win32' ? a.toLowerCase() === b.toLowerCase() : a === b;
+}
+
+ipcMain.on('get-recent-files', (event) => {
+  event.returnValue = loadRecentFiles();
+});
+
